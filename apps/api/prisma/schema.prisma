generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  maxClients   Int
  priceMonthly Decimal  @db.Decimal(10, 2)
  features     Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizations Organization[]

  @@map("plans")
}

model Organization {
  holidays Holiday[]
  delayReasons DelayReason[]
  osModels OSModel[]
  inAppNotifications  InAppNotification[]
  taskApprovals       TaskApproval[]
  id                  String              @id @default(cuid())
  name                String
  slug                String              @unique
  cnpj                String?             @unique
  email               String              @unique
  phone               String?
  planId              String
  subscriptionStatus  SubscriptionStatus  @default(TRIAL)
  trialEndsAt         DateTime?
  gracePeriodEndsAt   DateTime?
  asaasCustomerId     String?
  asaasSubscriptionId String?
  billingMode         BillingMode         @default(ASAAS)
  // MANUAL only: next payment of the agreement (date-only, UTC midnight)
  manualNextDueDate   DateTime?
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  plan                   Plan                    @relation(fields: [planId], references: [id])
  users                  User[]
  clients                Client[]
  clientUsers            ClientUser[]
  boards                 Board[]
  requests               Request[]
  notificationConfig     NotificationConfig?
  messageTemplates       MessageTemplate[]
  notificationLogs       NotificationLog[]
  subscriptionHistory    SubscriptionHistory[]
  departments            Department[]
  recurringTaskTemplates RecurringTaskTemplate[]
  processTemplates       ProcessTemplate[]
  protocols              Protocol[]
  protocolCounters       ProtocolCounter[]
  obligationTypes        ObligationType[]
  documentModels         DocumentModel[]
  receivedDocuments      ReceivedDocument[]

  @@map("organizations")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

// How the office pays AutoHubs: Asaas subscription (webhook drives the status) or a direct agreement
// (the Master controls the status; manualNextDueDate only reminds)
enum BillingMode {
  ASAAS
  MANUAL
}

model SubscriptionHistory {
  id             String   @id @default(cuid())
  organizationId String
  event          String
  planId         String?
  amount         Decimal? @db.Decimal(10, 2)
  asaasPaymentId String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  // Asaas resends events: the same event of the same payment is applied once
  @@unique([asaasPaymentId, event])
  @@map("subscription_history")
}

model User {
  reviewedAttachments Attachment[] @relation("AttachmentReviewer")
  id                  String       @id @default(cuid())
  name                String
  email               String       @unique
  passwordHash        String
  role                UserRole     @default(ORG_MEMBER)
  phone               String?
  organizationId      String
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organization                 Organization              @relation(fields: [organizationId], references: [id])
  assignedTasks                Task[]                    @relation("TaskAssignee")
  createdTasks                 Task[]                    @relation("TaskCreator")
  reviewedRequests             Request[]                 @relation("RequestReviewer")
  comments                     Comment[]
  requestComments              RequestComment[]
  protocols                    Protocol[]
  cancelledProtocols           Protocol[]                @relation("ProtocolCancelledBy")
  attachments                  Attachment[]
  responsibleBoards            Board[]                   @relation("BoardResponsible")
  clientAssignments            ClientAssignment[]
  departments                  UserDepartment[]
  notifications                InAppNotification[]
  approvalsRequested           TaskApproval[]            @relation("ApprovalRequestedBy")
  approvalsDecided             TaskApproval[]            @relation("ApprovalDecidedByUser")
  // ORG_MEMBER only: sees the work of department colleagues (spec visibilidade-por-departamento)
  seesDepartmentWork           Boolean                   @default(true)
  reviewedDocumentRequirements TaskDocumentRequirement[]
  deliveredDeliverables        TaskDeliverable[]
  slaPreference                UserSlaPreference?
  createdObligationTypes       ObligationType[]
  createdDocumentModels        DocumentModel[]
  uploadedDocuments            ReceivedDocument[]        @relation("ReceivedDocumentUploadedBy")
  reviewedDocuments            ReceivedDocument[]        @relation("ReceivedDocumentReviewedBy")

  @@map("users")
}

model UserSlaPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  targetWarningSound  String   @default("SOFT_PING")
  targetWarningVolume Int      @default(50)
  dueCriticalSound    String   @default("BELL")
  dueCriticalVolume   Int      @default(70)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sla_preferences")
}

enum UserRole {
  MASTER
  ORG_ADMIN
  ORG_MANAGER
  ORG_MEMBER
}

model Client {
  id                String  @id @default(cuid())
  name              String
  clientType        String  @default("PJ")
  codigo            String
  cnpj              String?
  cpf               String?
  cei               String?
  caepf             String?
  inscricaoEstadual String?
  whatsapp          String?
  phone             String?
  notes             String?

  cep         String?
  estado      String?
  cidade      String?
  // IBGE code of the city (required by the API since 2026-11-17; null only on older clients)
  ibgeCityCode Int?
  bairro      String?
  logradouro  String?
  numero      String?
  complemento String?

  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization             Organization              @relation(fields: [organizationId], references: [id])
  municipality             Municipality?             @relation(fields: [ibgeCityCode], references: [ibgeCode], onDelete: Restrict)
  boards                   Board[]
  requests                 Request[]
  comments                 Comment[]
  requestComments          RequestComment[]
  protocols                Protocol[]
  attachments              Attachment[]
  clientAssignments        ClientAssignment[]
  recurringTaskAssignments RecurringTaskAssignment[]
  clientUserAccesses       ClientUserAccess[]

  // Garantias escritas à mão na migration 20261111120000_client_required_fields (o Prisma não
  // expressa CHECK nem índice parcial — `prisma migrate diff` não detecta drift neles):
  // - CHECK clients_document_by_type_check: PJ exige cnpj, PF exige cpf;
  // - índices únicos parciais (só clientes ativos): clients_codigo_active_key,
  //   clients_cnpj_active_key, clients_cpf_active_key — cliente desativado não trava recadastro.
  @@index([ibgeCityCode])
  @@map("clients")
}

model ClientUser {
  uploadedAttachments Attachment[] @relation("AttachmentClientUploader")
  id                  String       @id @default(cuid())
  organizationId      String
  name                String
  email               String
  passwordHash        String
  phone               String?
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accesses         ClientUserAccess[]
  notifications    InAppNotification[]
  approvalsDecided TaskApproval[]      @relation("ApprovalDecidedByClientUser")
  paidProtocols    Protocol[]

  @@unique([email, organizationId])
  @@map("client_users")
}

model ClientUserAccess {
  id           String @id @default(cuid())
  clientUserId String
  clientId     String
  departmentId String

  clientUser ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([clientUserId, clientId, departmentId])
  @@index([clientId])
  @@index([departmentId])
  @@map("client_user_accesses")
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAssignments      ClientAssignment[]
  tasks                  Task[]
  requests               Request[]
  recurringTaskTemplates RecurringTaskTemplate[]
  clientUserAccesses     ClientUserAccess[]
  members                UserDepartment[]
  processTemplates       ProcessTemplate[]
  osModels               OSModel[]

  @@unique([organizationId, name])
  @@map("departments")
}

model ClientAssignment {
  id           String   @id @default(cuid())
  clientId     String
  departmentId String
  userId       String
  createdAt    DateTime @default(now())

  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, departmentId])
  @@map("client_assignments")
}

model Board {
  inAppNotifications InAppNotification[]
  id                 String              @id @default(cuid())
  title              String
  description        String?
  organizationId     String
  clientId           String
  responsibleUserId  String?
  isActive           Boolean             @default(true)
  dueDate            DateTime?
  type               BoardType           @default(PROCESS)
  processTemplateId  String?
  // Process clock (business days, pauses while every open OS waits for the client) and delay reason
  deadlineBusinessDays Int?
  targetDate           DateTime?
  competence           DateTime?
  completedAt          DateTime?
  delayReasonId        String?
  delayNote            String?
  delayReasonPending   Boolean   @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  client          Client       @relation(fields: [clientId], references: [id])
  responsibleUser User?        @relation("BoardResponsible", fields: [responsibleUserId], references: [id])
  processTemplate ProcessTemplate? @relation(fields: [processTemplateId], references: [id])
  columns         Column[]
  pauses          BoardPause[]
  requests        Request[]        @relation("RequestBoard")
  delayReason     DelayReason?     @relation(fields: [delayReasonId], references: [id], onDelete: SetNull)

  @@index([processTemplateId])
  @@index([delayReasonId])
  // Partial unique indexes outside the schema: one SERVICE_SYSTEM board per client
  // (boards_client_service_system_key, migration 20261116110000) and one RECURRING_SYSTEM board per
  // client (boards_client_recurring_system_key, 20261116120000). Never accept a generated DROP of them.
  @@map("boards")
}

model Request {
  inAppNotifications InAppNotification[]
  id                 String              @id @default(cuid())
  organizationId     String
  clientId           String
  title              String
  description        String?
  status             RequestStatus       @default(PENDING)
  taskId             String?             @unique
  departmentId       String
  rejectionReason    String?
  reviewedById       String?
  reviewedAt         DateTime?
  processTemplateId  String?
  // Client asked for a standalone OS (model) of a period (competence), or the approval opened a process (boardId)
  osModelId          String?
  competence         DateTime?
  boardId            String?
  cancelledByType    CommentAuthorType?
  cancelledById      String?
  cancellationReason String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  client       Client              @relation(fields: [clientId], references: [id])
  task         Task?               @relation(fields: [taskId], references: [id])
  department   Department          @relation(fields: [departmentId], references: [id])
  reviewedBy   User?               @relation("RequestReviewer", fields: [reviewedById], references: [id])
  processTemplate ProcessTemplate? @relation(fields: [processTemplateId], references: [id])
  osModel         OSModel?         @relation(fields: [osModelId], references: [id], onDelete: SetNull)
  board           Board?           @relation("RequestBoard", fields: [boardId], references: [id], onDelete: SetNull)
  attachments  RequestAttachment[]
  comments     RequestComment[]

  @@index([organizationId, status])
  @@index([departmentId])
  @@index([processTemplateId])
  @@index([osModelId])
  @@index([boardId])
  @@map("requests")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  NEEDS_INFO
}

model RequestAttachment {
  id         String   @id @default(cuid())
  requestId  String
  filename   String
  mimeType   String
  size       Int
  storageKey String
  uploadedBy String
  createdAt  DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("request_attachments")
}

model RequestComment {
  id            String            @id @default(cuid())
  content       String
  requestId     String
  authorType    CommentAuthorType
  userId        String?
  clientId      String?
  deletedAt     DateTime?
  deletedBy     String?
  deletedByType DeletedByType?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])
  client  Client? @relation(fields: [clientId], references: [id])

  // listRequestComments ordena por requestId + createdAt.
  @@index([requestId, createdAt])
  @@map("request_comments")
}

model Column {
  id           String             @id @default(cuid())
  title        String
  position     Int
  color        String?
  statusEffect ColumnStatusEffect @default(NONE)
  notifyClient Boolean            @default(false)
  boardId      String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  board     Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]
  documents ColumnDocument[]

  @@map("columns")
}

model ColumnDocument {
  id       String @id @default(cuid())
  columnId String
  name     String
  position Int

  column Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@map("column_documents")
}

model Task {
  inAppNotifications  InAppNotification[]
  id                  String              @id @default(cuid())
  title               String
  description         String?
  position            Int
  priority            Priority            @default(MEDIUM)
  status              TaskStatus          @default(OPEN)
  dueDate             DateTime?
  columnId            String
  assigneeId          String?
  creatorId           String?
  sourceRequestId     String?
  departmentId        String
  tags                String[]
  competence          DateTime?
  targetDate          DateTime?
  completedAt         DateTime?
  recurringTemplateId String?
  visibleToClient     Boolean             @default(true)
  // OS (service order): the model it came from, when it was released (null = waiting for the OS it
  // depends on), its internal deadline in business days and the delay reason when it finished late
  osModelId            String?
  releasedAt           DateTime?
  deadlineBusinessDays Int?
  delayReasonId        String?
  delayNote            String?
  delayReasonPending   Boolean   @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  osModel              OSModel?                  @relation(fields: [osModelId], references: [id], onDelete: SetNull)
  delayReason          DelayReason?              @relation(fields: [delayReasonId], references: [id], onDelete: SetNull)
  dependsOn            TaskDependency[]          @relation("TaskDependsOn")
  pauses               TaskPause[]
  dependents           TaskDependency[]          @relation("TaskDependents")
  column               Column                    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee             User?                     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator              User?                     @relation("TaskCreator", fields: [creatorId], references: [id])
  department           Department                @relation(fields: [departmentId], references: [id])
  comments             Comment[]
  history              TaskHistory[]
  attachments          Attachment[]
  sourceForRequest     Request?
  recurringTemplate    RecurringTaskTemplate?    @relation(fields: [recurringTemplateId], references: [id])
  documentRequirements TaskDocumentRequirement[]
  deliverables         TaskDeliverable[]
  approvals            TaskApproval[]
  protocols            Protocol[]
  receivedDocuments    ReceivedDocument[]

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([title])
  @@index([competence])
  @@index([targetDate])
  @@index([departmentId])
  @@index([completedAt])
  @@index([assigneeId])
  @@index([osModelId])
  @@index([delayReasonId])
  @@map("tasks")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  STARTED
  DONE
  DISREGARDED
  BLOCKED
}

enum ColumnStatusEffect {
  NONE
  OPEN
  STARTED
  BLOCKED
  DISREGARDED
  DONE
}

enum BoardType {
  PROCESS
  RECURRING_SYSTEM
  // One per client: holds its standalone OS (service orders), like RECURRING_SYSTEM holds recurring tasks
  SERVICE_SYSTEM
}

model ProcessTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  // Department that evaluates client requests for this process and owns its manual tasks
  departmentId         String?
  deadlineBusinessDays Int?
  clientCanRequest     Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  columns      ProcessTemplateColumn[]
  items        ProcessTemplateItem[]
  requests     Request[]
  boards       Board[]

  @@index([organizationId])
  @@index([departmentId])
  @@map("process_templates")
}

model ProcessTemplateColumn {
  id           String             @id @default(cuid())
  templateId   String
  title        String
  position     Int
  statusEffect ColumnStatusEffect @default(NONE)
  notifyClient Boolean            @default(false)

  template  ProcessTemplate                 @relation(fields: [templateId], references: [id], onDelete: Cascade)
  documents ProcessTemplateColumnDocument[]

  @@index([templateId])
  @@map("process_template_columns")
}

model ProcessTemplateColumnDocument {
  id       String @id @default(cuid())
  columnId String
  name     String
  position Int

  column ProcessTemplateColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId])
  @@map("process_template_column_documents")
}

model RecurringTaskTemplate {
  id             String                @id @default(cuid())
  organizationId String
  departmentId   String
  title          String
  description    String?
  periodicity    RecurrencePeriodicity
  priority       Priority              @default(MEDIUM)

  dueDayOfPeriod     Int
  dueBusinessDayRoll BusinessDayRoll @default(NONE)

  // Mês-âncora de vencimento — só relevante pra QUARTERLY (valor 1-3, define qual dos 3 grupos
  // de meses: 1="Jan,Abr,Jul,Out", 2="Fev,Mai,Ago,Nov", 3="Mar,Jun,Set,Dez", via mês % 3) e
  // ANNUAL (valor 1-12, mês literal do vencimento). Ignorado por MONTHLY/WEEKLY.
  dueMonthAnchor Int @default(1)

  competenceMonthOffset Int @default(1)

  targetOffsetDays      Int             @default(0)
  targetBusinessDayRoll BusinessDayRoll @default(NONE)

  generationMonthOffset Int @default(1)
  generationDayOfPeriod Int

  autoCompleteOnAllActivitiesDone Boolean @default(false)

  notifyViaWhatsapp Boolean @default(true)
  notifyViaEmail    Boolean @default(false)

  visibleToClient Boolean @default(true)

  // Where the due date changes: FEDERAL (one date for all), STATE (rules by UF) or CITY (rules by
  // IBGE city). onlyListedLocations: clients outside the listed places get no task (fails, visible)
  dueScope            LocationScope @default(FEDERAL)
  onlyListedLocations Boolean       @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dueRules           RecurringDueRule[]
  organization       Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department         Department                      @relation(fields: [departmentId], references: [id])
  documentRequests   RecurringTaskTemplateDocument[] @relation("TemplateDocumentRequests")
  documentDeliveries RecurringTaskTemplateDocument[] @relation("TemplateDocumentDeliveries")
  assignments        RecurringTaskAssignment[]
  tasks              Task[]
  generationLogs     RecurringGenerationLog[]

  @@map("recurring_task_templates")
}

enum RecurrencePeriodicity {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum BusinessDayRoll {
  NONE
  FORWARD
  BACKWARD
}

enum LocationScope {
  FEDERAL
  STATE
  CITY
}

// The due date of a recurring template in one place: a UF (scope STATE) or an IBGE city (scope CITY).
// Only the day and the business-day roll change; everything else is the template's.
// The migration also adds a hand-written CHECK (exactly one of uf / ibgeCityCode) that Prisma does
// not model: keep it if this table's migration is ever regenerated.
model RecurringDueRule {
  id                 String          @id @default(cuid())
  templateId         String
  uf                 String?         @db.Char(2)
  ibgeCityCode       Int?
  dueDayOfPeriod     Int
  dueBusinessDayRoll BusinessDayRoll @default(NONE)

  template     RecurringTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  municipality Municipality?         @relation(fields: [ibgeCityCode], references: [ibgeCode], onDelete: Restrict)

  @@unique([templateId, uf])
  @@unique([templateId, ibgeCityCode])
  @@map("recurring_due_rules")
}

model RecurringTaskTemplateDocument {
  id                 String  @id @default(cuid())
  requestTemplateId  String?
  deliveryTemplateId String?
  name               String
  position           Int
  // Only meaningful on delivery rows: the generated deliverable is a payment guide
  requiresPayment    Boolean @default(false)
  // Only on delivery rows: the obligation the document reader recognizes for this document (robot)
  obligationTypeId   String?

  requestTemplate  RecurringTaskTemplate? @relation("TemplateDocumentRequests", fields: [requestTemplateId], references: [id], onDelete: Cascade)
  deliveryTemplate RecurringTaskTemplate? @relation("TemplateDocumentDeliveries", fields: [deliveryTemplateId], references: [id], onDelete: Cascade)
  obligationType   ObligationType?        @relation(fields: [obligationTypeId], references: [id], onDelete: SetNull)

  @@map("recurring_task_template_documents")
}

model RecurringTaskAssignment {
  id         String   @id @default(cuid())
  templateId String
  clientId   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  template RecurringTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  client   Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([templateId, clientId])
  @@map("recurring_task_assignments")
}

model RecurringGenerationLog {
  id           String           @id @default(cuid())
  templateId   String
  clientId     String
  competence   DateTime
  status       GenerationStatus
  taskId       String?
  errorMessage String?
  createdAt    DateTime         @default(now())

  template RecurringTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, clientId, competence])
  @@map("recurring_generation_logs")
}

enum GenerationStatus {
  SUCCESS
  FAILED
}

model TaskDocumentRequirement {
  id              String                    @id @default(cuid())
  taskId          String
  name            String
  status          DocumentRequirementStatus @default(PENDING)
  attachmentId    String?                   @unique
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  position        Int
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  task       Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attachment Attachment?  @relation("RequirementCurrentFile", fields: [attachmentId], references: [id])
  reviewedBy User?        @relation(fields: [reviewedById], references: [id])
  // Every file ever sent for this request (current one included), with how each was reviewed
  versions   Attachment[] @relation("RequirementVersions")

  @@map("task_document_requirements")
}

enum DocumentRequirementStatus {
  PENDING
  UPLOADED
  APPROVED
  REJECTED
  NOT_APPLICABLE
}

model TaskDeliverable {
  id               String    @id @default(cuid())
  taskId           String
  name             String
  attachmentId     String?   @unique
  deliveredById    String?
  deliveredAt      DateTime?
  position         Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  // Payment guide (DAS, FGTS...): amount and due date informed by the office on delivery
  requiresPayment  Boolean   @default(false)
  amount           Decimal?  @db.Decimal(12, 2)
  paymentDueDate   DateTime?
  // Robot: the obligation the document reader recognizes for this delivery (copied from the template)
  obligationTypeId String?

  task              Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attachment        Attachment?        @relation(fields: [attachmentId], references: [id])
  deliveredBy       User?              @relation(fields: [deliveredById], references: [id])
  protocol          Protocol?
  obligationType    ObligationType?    @relation(fields: [obligationTypeId], references: [id], onDelete: SetNull)
  receivedDocuments ReceivedDocument[]

  @@map("task_deliverables")
}

model Protocol {
  id             String         @id @default(cuid())
  organizationId String
  number         String
  clientId       String
  taskId         String
  attachmentId   String?        @unique
  title          String
  content        String?
  dueDate        DateTime?
  status         ProtocolStatus @default(SENT)
  createdById    String
  createdAt      DateTime       @default(now())

  // Client portal "documentos recebidos": competence, payment and lifecycle. dueDate above is the
  // guide's due date (vencimento).
  competence               DateTime?
  requiresPayment          Boolean   @default(false)
  amount                   Decimal?  @db.Decimal(12, 2)
  paidAt                   DateTime?
  paidAmount               Decimal?  @db.Decimal(12, 2)
  paidByClientUserId       String?
  paymentProofAttachmentId String?   @unique
  deliverableId            String?   @unique
  cancelledAt              DateTime?
  cancelledById            String?
  cancellationReason       String?
  fileUpdatedAt            DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id])
  client       Client           @relation(fields: [clientId], references: [id])
  task         Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attachment   Attachment?      @relation(fields: [attachmentId], references: [id])
  createdBy    User             @relation(fields: [createdById], references: [id])
  events       ProtocolEvent[]
  paidBy       ClientUser?      @relation(fields: [paidByClientUserId], references: [id])
  paymentProof Attachment?      @relation("ProtocolPaymentProof", fields: [paymentProofAttachmentId], references: [id])
  deliverable  TaskDeliverable? @relation(fields: [deliverableId], references: [id])
  cancelledBy  User?            @relation("ProtocolCancelledBy", fields: [cancelledById], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([clientId])
  @@index([organizationId, requiresPayment, paidAt])
  @@map("protocols")
}

enum ProtocolStatus {
  SENT
  VIEWED
  DOWNLOADED
  EXPIRED
}

model ProtocolEvent {
  id                   String            @id @default(cuid())
  protocolId           String
  type                 ProtocolEventType
  actorType            String
  actorId              String?
  actorName            String?
  actorEmail           String?
  ip                   String?
  userAgent            String?
  createdAt            DateTime          @default(now())
  // Free text shown in the history ("R$ 10,00 → R$ 12,00", cancellation reason)
  detail               String?
  // File replaced by a REPLACED event — kept, never deleted
  previousAttachmentId String?

  protocol Protocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  @@index([protocolId, createdAt])
  @@map("protocol_events")
}

enum ProtocolEventType {
  SENT
  VIEWED
  DOWNLOADED
  EXPIRED
  PAID
  UNPAID
  AMOUNT_CHANGED
  REPLACED
  CANCELLED
}

model ProtocolCounter {
  organizationId String
  year           Int
  lastNumber     Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, year])
  @@map("protocol_counters")
}

model Comment {
  id            String            @id @default(cuid())
  content       String
  taskId        String
  authorType    CommentAuthorType
  userId        String?
  clientId      String?
  deletedAt     DateTime?
  deletedBy     String?
  deletedByType DeletedByType?
  // Office-only note: never shown nor announced to the client (portal, notifications)
  isInternal    Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  // listComments ordena por taskId + createdAt — débito pré-existente ao Plano de
  // Solicitações->OS, corrigido junto com RequestComment por serem o mesmo padrão.
  @@index([taskId, createdAt])
  @@map("comments")
}

enum CommentAuthorType {
  USER
  CLIENT
}

enum DeletedByType {
  USER
  CLIENT
}

model TaskHistory {
  id        String   @id @default(cuid())
  taskId    String
  action    String
  fromValue String?
  toValue   String?
  // moved_to: the columns by id (titles change; stage times must not lose the history). No FK — a
  // deleted column keeps its past moves.
  fromColumnId String?
  toColumnId   String?
  actorType String
  actorId   String
  actorName String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Postgres não indexa FK automaticamente (diferente de MySQL) — sem isso, toda consulta de
  // métricas (`taskId: { in: [...] }`) varre a tabela inteira sequencialmente.
  @@index([taskId, action, createdAt])
  @@map("task_history")
}

model Attachment {
  id               String    @id @default(cuid())
  taskId           String
  filename         String
  mimeType         String
  size             Int
  storageKey       String
  uploadedBy       String?
  uploadedByClient String?
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?
  deletedBy        String?
  deletedByClient  String?
  deletedByName    String?

  task                   Task                     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader               User?                    @relation(fields: [uploadedBy], references: [id])
  uploaderClient         Client?                  @relation(fields: [uploadedByClient], references: [id])
  documentRequirement    TaskDocumentRequirement? @relation("RequirementCurrentFile")
  // Document trail: which request this file answered, who sent it (person) and how it was reviewed
  requirementId          String?
  reviewStatus           AttachmentReview?
  rejectionReason        String?
  reviewedAt             DateTime?
  reviewedById           String?
  uploadedByClientUserId String?
  requirement            TaskDocumentRequirement? @relation("RequirementVersions", fields: [requirementId], references: [id], onDelete: SetNull)
  reviewedBy             User?                    @relation("AttachmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  uploaderClientUser     ClientUser?              @relation("AttachmentClientUploader", fields: [uploadedByClientUserId], references: [id], onDelete: SetNull)
  deliverable            TaskDeliverable?
  protocol               Protocol?
  receivedDocument       ReceivedDocument?
  paymentProofOf         Protocol?                @relation("ProtocolPaymentProof")
  approvalFileOf         TaskApproval?            @relation("ApprovalFile")
  approvalProofOf        TaskApproval?            @relation("ApprovalProof")

  @@index([requirementId])
  @@map("attachments")
}

model NotificationConfig {
  id                        String   @id @default(cuid())
  organizationId            String   @unique
  whatsappEnabled           Boolean  @default(true)
  emailEnabled              Boolean  @default(true)
  taskCreated               Boolean  @default(false)
  taskMoved                 Boolean  @default(true)
  taskCompleted             Boolean  @default(true)
  commentAdded              Boolean  @default(true)
  taskBlocked               Boolean  @default(true)
  requestCreated            Boolean  @default(true)
  requestApproved           Boolean  @default(true)
  requestRejected           Boolean  @default(true)
  requestNeedsInfo          Boolean  @default(true)
  requestCommentAdded       Boolean  @default(true)
  requestCancelled          Boolean  @default(true)
  protocolCreated           Boolean  @default(true)
  taskAssumed               Boolean  @default(true)
  approvalRequested         Boolean  @default(true)
  approvalChangesRequested  Boolean  @default(true)
  maximizebotToken          String?
  saveOnTicket              Boolean  @default(true)
  startChatbot              Boolean  @default(false)
  recurringGenerationFailed Boolean  @default(true)
  documentRejected          Boolean  @default(true)
  slaTargetWarningDays      Int      @default(3)
  slaDueCriticalDays        Int      @default(1)
  protocolWarningDays       Int      @default(3)
  slaDigestEnabled          Boolean  @default(true)
  lateClosureThresholdDays  Int      @default(2)
  customSlaSoundKey         String?
  customSlaSoundLabel       String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("notification_configs")
}

model MessageTemplate {
  id             String            @id @default(cuid())
  organizationId String
  event          NotificationEvent
  channel        MessageChannel
  subject        String?
  body           String
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, event, channel])
  @@map("message_templates")
}

enum NotificationEvent {
  TASK_CREATED
  TASK_MOVED
  TASK_COMPLETED
  TASK_COMMENT_ADDED
  TASK_BLOCKED
  REQUEST_CREATED
  REQUEST_APPROVED
  REQUEST_REJECTED
  RECURRING_GENERATION_FAILED
  DOCUMENT_REJECTED
  SLA_DIGEST
  REQUEST_NEEDS_INFO
  REQUEST_COMMENT_ADDED
  REQUEST_CANCELLED
  PROTOCOL_CREATED
  TASK_ASSUMED
  APPROVAL_REQUESTED
  APPROVAL_CHANGES_REQUESTED
}

enum MessageChannel {
  WHATSAPP
  EMAIL
}

model NotificationLog {
  id             String             @id @default(cuid())
  organizationId String
  clientId       String?
  event          NotificationEvent
  channel        MessageChannel
  taskId         String?
  requestId      String?
  recipient      String
  message        String
  status         NotificationStatus @default(PENDING)
  error          String?
  sentAt         DateTime?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("notification_logs")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model ObligationType {
  id             String   @id @default(cuid())
  code           String // "IRPJ", "DAS", "CSLL", "PGDAS-D"
  name           String
  organizationId String? // null = global (AutoHubs); preenchido = só do escritório
  isActive       Boolean  @default(true)
  createdById    String? // null pros globais
  createdAt      DateTime @default(now())

  // Restrict (não o SetNull default do Prisma pra FK opcional): sem isso, apagar uma org tornaria
  // os ObligationType privados dela GLOBAIS (organizationId vira null = global neste sistema) —
  // exatamente a classe de vazamento de isolamento entre escritórios que o resto da base evita.
  organization      Organization?                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy         User?                           @relation(fields: [createdById], references: [id])
  documentModels    DocumentModel[]
  templateDocuments RecurringTaskTemplateDocument[]
  taskDeliverables  TaskDeliverable[]
  osModelDocuments  OSModelDocument[]

  // Só garante unicidade de code quando organizationId NÃO é null (Postgres trata múltiplos NULL
  // como distintos nesse tipo de índice) — a unicidade de code entre os GLOBAIS (organizationId
  // null) vem de um índice único PARCIAL que a sintaxe do Prisma schema não expressa, criado à
  // mão na migration 20261019020000_obligation_type_global_code_unique:
  //   CREATE UNIQUE INDEX "obligation_types_code_global_key" ON "obligation_types"("code")
  //   WHERE "organizationId" IS NULL;
  @@unique([organizationId, code])
  @@map("obligation_types")
}

model DocumentModel {
  id               String   @id @default(cuid())
  organizationId   String? // null = global
  obligationTypeId String
  name             String
  version          Int      @default(1)
  isActive         Boolean  @default(true)
  // Formato: { ancoras: Ancora[], zonas: Zona[], tipoImpostoCampo?: string, subtipos?: Record<string,string> }
  definicao        Json
  createdById      String?
  createdAt        DateTime @default(now())

  obligationType ObligationType     @relation(fields: [obligationTypeId], references: [id])
  // Restrict pelo mesmo motivo de ObligationType.organization acima.
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User?              @relation(fields: [createdById], references: [id])
  documentos     ReceivedDocument[]

  @@map("document_models")
}

model ReceivedDocument {
  id              String                 @id @default(cuid())
  organizationId  String
  attachmentId    String?                @unique
  fileHash        String
  documentNumber  String?
  storageKey      String
  uploadedById    String?
  status          ReceivedDocumentStatus @default(PENDING)
  documentModelId String?
  modelVersion    Int?
  confidence      Float?
  extractedFields Json?
  taskId          String?
  // Delivery the robot suggests filling (with taskId)
  deliverableId   String?
  how             String?
  reviewedById    String?
  reviewedAt      DateTime?
  // Lease taken by the reviewer attaching this document (anexarDocumento) before any side effect;
  // a stale lease (process died mid-way) can be retaken after 5 minutes.
  attachingSince  DateTime?
  createdAt       DateTime               @default(now())

  organization  Organization     @relation(fields: [organizationId], references: [id])
  documentModel DocumentModel?   @relation(fields: [documentModelId], references: [id])
  task          Task?            @relation(fields: [taskId], references: [id])
  deliverable   TaskDeliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  attachment    Attachment?      @relation(fields: [attachmentId], references: [id])
  uploadedBy    User?            @relation("ReceivedDocumentUploadedBy", fields: [uploadedById], references: [id])
  reviewedBy    User?            @relation("ReceivedDocumentReviewedBy", fields: [reviewedById], references: [id])

  @@unique([organizationId, fileHash])
  @@index([deliverableId])
  // listarFilaDeRevisao filtra por organizationId + status IN (PENDING, NOT_IDENTIFIED).
  @@index([organizationId, status])
  // purgeRejectedDocuments (cron LGPD) filtra por status = REJECTED + reviewedAt < cutoff.
  @@index([status, reviewedAt])
  @@map("received_documents")
}

enum ReceivedDocumentStatus {
  PENDING
  ATTACHED
  NOT_IDENTIFIED
  REJECTED
}

// Staff membership in departments: defines what managers and members see (staff-scope).
model UserDepartment {
  id           String   @id @default(cuid())
  userId       String
  departmentId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@map("user_departments")
}

// In-app notification center (bell): one row per recipient, always written regardless of the
// WhatsApp/e-mail toggles. Exactly one recipient (check constraint in the migration).
model InAppNotification {
  id                    String    @id @default(cuid())
  organizationId        String
  recipientUserId       String?
  recipientClientUserId String?
  type                  InAppType
  title                 String
  body                  String
  link                  String
  taskId                String?
  boardId               String?
  requestId             String?
  approvalId            String?
  protocolId            String?
  clientId              String?
  actorName             String?
  readAt                DateTime?
  createdAt             DateTime  @default(now())

  recipientUser       User?        @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientClientUser ClientUser?  @relation(fields: [recipientClientUserId], references: [id], onDelete: Cascade)
  // A deleted task/request/process takes its notifications along (no dead links)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task                Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  board               Board?       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  request             Request?     @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt, createdAt])
  @@index([recipientClientUserId, readAt, createdAt])
  @@index([taskId])
  @@index([boardId])
  @@index([requestId])
  @@index([organizationId])
  @@map("in_app_notifications")
}

enum InAppType {
  TASK_COMMENT
  REQUEST_CREATED
  REQUEST_COMMENT
  DOCUMENT_UPLOADED
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  TASK_ASSUMED
  TASK_ASSIGNED
  BOARD_ASSIGNED
  DOCUMENT_RECEIVED
  DOCUMENT_REJECTED
  REQUEST_STATUS
  OS_RELEASED
}

// Client approval of a file inside a task (e.g. payroll preview). The office may close it without the
// portal, recording why and how long it waited.
model TaskApproval {
  id                    String               @id @default(cuid())
  taskId                String
  organizationId        String
  title                 String
  message               String?
  attachmentId          String               @unique
  status                ApprovalStatus       @default(PENDING)
  requestedById         String
  requestedAt           DateTime             @default(now())
  decidedAt             DateTime?
  decidedByClientUserId String?
  decidedByUserId       String?
  decisionNote          String?
  closeReason           ApprovalCloseReason?
  proofAttachmentId     String?              @unique
  waitedDays            Int?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task                Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attachment          Attachment   @relation("ApprovalFile", fields: [attachmentId], references: [id])
  proof               Attachment?  @relation("ApprovalProof", fields: [proofAttachmentId], references: [id])
  requestedBy         User         @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedByUser       User?        @relation("ApprovalDecidedByUser", fields: [decidedByUserId], references: [id])
  decidedByClientUser ClientUser?  @relation("ApprovalDecidedByClientUser", fields: [decidedByClientUserId], references: [id])

  @@index([taskId, status])
  @@map("task_approvals")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  CLOSED_BY_OFFICE
}

enum ApprovalCloseReason {
  APPROVED_OUTSIDE
  NO_RESPONSE
}

// How the office reviewed a file sent for a document request. REPLACED = a newer file came before review
enum AttachmentReview {
  PENDING_REVIEW
  APPROVED
  REJECTED
  REPLACED
}

// Holidays of an office (municipal, state, Carnaval, recess) on top of the built-in national ones
// (lib/business-days). One business-day calendar for the whole system: recurring due/target dates
// and OS/process deadlines.
model Holiday {
  id             String   @id @default(cuid())
  organizationId String
  date           DateTime @db.Date
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@map("holidays")
}

// An OS (service order) is a single task, like a recurring one but sporadic. The model configures
// it: documents to ask/deliver (robot per delivery), internal deadline in business days, competence,
// auto-completion, and where it is used (standalone — office opens, client requests — or in processes).
model OSModel {
  id                         String   @id @default(cuid())
  organizationId             String
  name                       String
  description                String?
  departmentId               String
  priority                   Priority @default(MEDIUM)
  visibleToClient            Boolean  @default(true)
  requiresCompetence         Boolean  @default(false)
  deadlineBusinessDays       Int?
  autoCompleteOnAllDelivered Boolean  @default(false)
  usableStandalone           Boolean  @default(true)
  usableInProcess            Boolean  @default(false)
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department         Department        @relation(fields: [departmentId], references: [id])
  documentRequests   OSModelDocument[] @relation("OSModelDocumentRequests")
  documentDeliveries OSModelDocument[] @relation("OSModelDocumentDeliveries")
  tasks              Task[]
  processItems       ProcessTemplateItem[]
  requests           Request[]

  @@index([organizationId, isActive])
  @@index([departmentId])
  @@map("os_models")
}

model OSModelDocument {
  id               String  @id @default(cuid())
  requestModelId   String?
  deliveryModelId  String?
  name             String
  position         Int
  // Delivery rows only: payment guide, and the obligation the robot recognizes for this document
  requiresPayment  Boolean @default(false)
  obligationTypeId String?

  requestModel  OSModel?        @relation("OSModelDocumentRequests", fields: [requestModelId], references: [id], onDelete: Cascade)
  deliveryModel OSModel?        @relation("OSModelDocumentDeliveries", fields: [deliveryModelId], references: [id], onDelete: Cascade)
  obligationType ObligationType? @relation(fields: [obligationTypeId], references: [id], onDelete: SetNull)

  @@index([requestModelId])
  @@index([deliveryModelId])
  @@index([obligationTypeId])
  @@map("os_model_documents")
}

// The OS a process template creates when a process is opened: which model, in which column it is
// born, and which other OS of the same template it waits for
model ProcessTemplateItem {
  id             String @id @default(cuid())
  templateId     String
  osModelId      String
  columnPosition Int
  position       Int

  template   ProcessTemplate                 @relation(fields: [templateId], references: [id], onDelete: Cascade)
  osModel    OSModel                         @relation(fields: [osModelId], references: [id])
  dependsOn  ProcessTemplateItemDependency[] @relation("ItemDependsOn")
  dependents ProcessTemplateItemDependency[] @relation("ItemDependents")

  @@index([templateId])
  @@index([osModelId])
  @@map("process_template_items")
}

model ProcessTemplateItemDependency {
  itemId          String
  dependsOnItemId String

  item      ProcessTemplateItem @relation("ItemDependsOn", fields: [itemId], references: [id], onDelete: Cascade)
  dependsOn ProcessTemplateItem @relation("ItemDependents", fields: [dependsOnItemId], references: [id], onDelete: Cascade)

  @@id([itemId, dependsOnItemId])
  @@index([dependsOnItemId])
  @@map("process_template_item_dependencies")
}

// An OS of a process waits until every OS it depends on is done (or disregarded)
model TaskDependency {
  taskId          String
  dependsOnTaskId String

  task      Task @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskDependents", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

// Periods an OS waited for the client (pending/rejected document or pending approval): its internal
// deadline does not run while paused
model TaskPause {
  id        String    @id @default(cuid())
  taskId    String
  startedAt DateTime
  endedAt   DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_pauses")
}

// Periods a process waited for the client (every open OS of it paused)
model BoardPause {
  id        String    @id @default(cuid())
  boardId   String
  startedAt DateTime
  endedAt   DateTime?

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@map("board_pauses")
}

// Why an OS or a process finished after its internal deadline (list configured by the office)
model DelayReason {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  requiresNote   Boolean @default(false)
  isActive       Boolean @default(true)
  position       Int

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        Task[]
  boards       Board[]

  @@unique([organizationId, name])
  @@map("delay_reasons")
}

// Brazil's municipalities (IBGE), shared by every office: loaded by migration from
// prisma/data/municipios-ibge.json. Clients and recurring due rules point here by IBGE code.
model Municipality {
  ibgeCode Int    @id
  name     String
  uf       String @db.Char(2)

  clients  Client[]
  dueRules RecurringDueRule[]

  @@index([uf])
  @@map("municipalities")
}
