  organizationId            String   @unique
  whatsappEnabled           Boolean  @default(true)
  emailEnabled              Boolean  @default(true)
  taskCreated               Boolean  @default(false)
  taskMoved                 Boolean  @default(true)
  taskCompleted             Boolean  @default(true)
  commentAdded              Boolean  @default(true)
  taskBlocked               Boolean  @default(true)
  requestCreated            Boolean  @default(true)
  requestApproved           Boolean  @default(true)
  requestRejected           Boolean  @default(true)
  requestNeedsInfo          Boolean  @default(true)
  requestCommentAdded       Boolean  @default(true)
  requestCancelled          Boolean  @default(true)
  protocolCreated           Boolean  @default(true)
  taskAssumed               Boolean  @default(true)
  approvalRequested         Boolean  @default(true)
  approvalChangesRequested  Boolean  @default(true)
  maximizebotToken          String?
  saveOnTicket              Boolean  @default(true)
  startChatbot              Boolean  @default(false)
  recurringGenerationFailed Boolean  @default(true)
  documentRejected          Boolean  @default(true)
  slaTargetWarningDays      Int      @default(3)
  slaDueCriticalDays        Int      @default(1)
  protocolWarningDays       Int      @default(3)
  slaDigestEnabled          Boolean  @default(true)
  lateClosureThresholdDays  Int      @default(2)
  customSlaSoundKey         String?
  customSlaSoundLabel       String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("notification_configs")
}

model MessageTemplate {
