  WHATSAPP
  EMAIL
}

model NotificationLog {
  id             String             @id @default(cuid())
  organizationId String
  clientId       String?
  event          NotificationEvent
  channel        MessageChannel
  taskId         String?
  requestId      String?
  recipient      String
  message        String
  status         NotificationStatus @default(PENDING)
  error          String?
  sentAt         DateTime?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("notification_logs")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model ObligationType {
  id             String   @id @default(cuid())
  code           String // "IRPJ", "DAS", "CSLL", "PGDAS-D"
  name           String
  organizationId String? // null = global (AutoHubs); preenchido = só do escritório
  isActive       Boolean  @default(true)
  createdById    String? // null pros globais
  createdAt      DateTime @default(now())

  // Restrict (não o SetNull default do Prisma pra FK opcional): sem isso, apagar uma org tornaria
  // os ObligationType privados dela GLOBAIS (organizationId vira null = global neste sistema) —
  // exatamente a classe de vazamento de isolamento entre escritórios que o resto da base evita.
  organization           Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy              User?                   @relation(fields: [createdById], references: [id])
  documentModels         DocumentModel[]
  recurringTaskTemplates RecurringTaskTemplate[]

  // Só garante unicidade de code quando organizationId NÃO é null (Postgres trata múltiplos NULL
  // como distintos nesse tipo de índice) — a unicidade de code entre os GLOBAIS (organizationId
  // null) vem de um índice único PARCIAL que a sintaxe do Prisma schema não expressa, criado à
  // mão na migration 20261019020000_obligation_type_global_code_unique:
  //   CREATE UNIQUE INDEX "obligation_types_code_global_key" ON "obligation_types"("code")
  //   WHERE "organizationId" IS NULL;
  @@unique([organizationId, code])
  @@map("obligation_types")
}

model DocumentModel {
  id               String   @id @default(cuid())
  organizationId   String? // null = global
  obligationTypeId String
  name             String
  version          Int      @default(1)
  isActive         Boolean  @default(true)
  // Formato: { ancoras: Ancora[], zonas: Zona[], tipoImpostoCampo?: string, subtipos?: Record<string,string> }
  definicao        Json
  createdById      String?
  createdAt        DateTime @default(now())

  obligationType ObligationType     @relation(fields: [obligationTypeId], references: [id])
  // Restrict pelo mesmo motivo de ObligationType.organization acima.
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User?              @relation(fields: [createdById], references: [id])
  documentos     ReceivedDocument[]

  @@map("document_models")
}

model ReceivedDocument {
  id              String                 @id @default(cuid())
  organizationId  String
  attachmentId    String?                @unique
  fileHash        String
  documentNumber  String?
  storageKey      String
  uploadedById    String?
  status          ReceivedDocumentStatus @default(PENDING)
  documentModelId String?
  modelVersion    Int?
  confidence      Float?
  extractedFields Json?
  taskId          String?
  how             String?
  reviewedById    String?
  reviewedAt      DateTime?
  // Lease taken by the reviewer attaching this document (anexarDocumento) before any side effect;
  // a stale lease (process died mid-way) can be retaken after 5 minutes.
  attachingSince  DateTime?
  createdAt       DateTime               @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id])
  documentModel DocumentModel? @relation(fields: [documentModelId], references: [id])
  task          Task?          @relation(fields: [taskId], references: [id])
  attachment    Attachment?    @relation(fields: [attachmentId], references: [id])
  uploadedBy    User?          @relation("ReceivedDocumentUploadedBy", fields: [uploadedById], references: [id])
  reviewedBy    User?          @relation("ReceivedDocumentReviewedBy", fields: [reviewedById], references: [id])

  @@unique([organizationId, fileHash])
  // listarFilaDeRevisao filtra por organizationId + status IN (PENDING, NOT_IDENTIFIED).
  @@index([organizationId, status])
  // purgeRejectedDocuments (cron LGPD) filtra por status = REJECTED + reviewedAt < cutoff.
  @@index([status, reviewedAt])
  @@map("received_documents")
}

enum ReceivedDocumentStatus {
  PENDING
  ATTACHED
  NOT_IDENTIFIED
  REJECTED
}

// Staff membership in departments: defines what managers and members see (staff-scope).
model UserDepartment {
  id           String   @id @default(cuid())
  userId       String
  departmentId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@map("user_departments")
}

// In-app notification center (bell): one row per recipient, always written regardless of the
// WhatsApp/e-mail toggles. Exactly one recipient (check constraint in the migration).
model InAppNotification {
  id                    String    @id @default(cuid())
  organizationId        String
  recipientUserId       String?
  recipientClientUserId String?
  type                  InAppType
  title                 String
  body                  String
  link                  String
  taskId                String?
  boardId               String?
  requestId             String?
  approvalId            String?
  protocolId            String?
  clientId              String?
  actorName             String?
  readAt                DateTime?
  createdAt             DateTime  @default(now())

  recipientUser       User?        @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientClientUser ClientUser?  @relation(fields: [recipientClientUserId], references: [id], onDelete: Cascade)
  // A deleted task/request/process takes its notifications along (no dead links)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task                Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  board               Board?       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  request             Request?     @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt, createdAt])
  @@index([recipientClientUserId, readAt, createdAt])
  @@index([taskId])
  @@index([boardId])
  @@index([requestId])
  @@map("in_app_notifications")
}

enum InAppType {
  TASK_COMMENT
  REQUEST_CREATED
  REQUEST_COMMENT
  DOCUMENT_UPLOADED
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  TASK_ASSUMED
  TASK_ASSIGNED
  BOARD_ASSIGNED
  DOCUMENT_RECEIVED
  DOCUMENT_REJECTED
  REQUEST_STATUS
}

// Client approval of a file inside a task (e.g. payroll preview). The office may close it without the
// portal, recording why and how long it waited.
model TaskApproval {
  id                    String               @id @default(cuid())
  taskId                String
  organizationId        String
  title                 String
  message               String?
  attachmentId          String               @unique
  status                ApprovalStatus       @default(PENDING)
  requestedById         String
  requestedAt           DateTime             @default(now())
  decidedAt             DateTime?
  decidedByClientUserId String?
  decidedByUserId       String?
  decisionNote          String?
  closeReason           ApprovalCloseReason?
  proofAttachmentId     String?              @unique
  waitedDays            Int?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task                Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attachment          Attachment   @relation("ApprovalFile", fields: [attachmentId], references: [id])
  proof               Attachment?  @relation("ApprovalProof", fields: [proofAttachmentId], references: [id])
  requestedBy         User         @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedByUser       User?        @relation("ApprovalDecidedByUser", fields: [decidedByUserId], references: [id])
  decidedByClientUser ClientUser?  @relation("ApprovalDecidedByClientUser", fields: [decidedByClientUserId], references: [id])

  @@index([taskId, status])
  @@map("task_approvals")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  CLOSED_BY_OFFICE
}

enum ApprovalCloseReason {
  APPROVED_OUTSIDE
  NO_RESPONSE
}
