generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  maxClients   Int
  priceMonthly Decimal  @db.Decimal(10, 2)
  features     Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizations Organization[]

  @@map("plans")
}

model Organization {
  inAppNotifications  InAppNotification[]
  taskApprovals       TaskApproval[]
  id                  String              @id @default(cuid())
  name                String
  slug                String              @unique
  cnpj                String?             @unique
  email               String              @unique
  phone               String?
  planId              String
  subscriptionStatus  SubscriptionStatus  @default(TRIAL)
  trialEndsAt         DateTime?
  gracePeriodEndsAt   DateTime?
  asaasCustomerId     String?
  asaasSubscriptionId String?
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  plan                   Plan                    @relation(fields: [planId], references: [id])
  users                  User[]
  clients                Client[]
  clientUsers            ClientUser[]
  boards                 Board[]
  requests               Request[]
  notificationConfig     NotificationConfig?
  messageTemplates       MessageTemplate[]
  notificationLogs       NotificationLog[]
  subscriptionHistory    SubscriptionHistory[]
  departments            Department[]
  recurringTaskTemplates RecurringTaskTemplate[]
  osTemplates            OSTemplate[]
  protocols              Protocol[]
  protocolCounters       ProtocolCounter[]
  obligationTypes        ObligationType[]
  documentModels         DocumentModel[]
  receivedDocuments      ReceivedDocument[]

  @@map("organizations")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

model SubscriptionHistory {
  id             String   @id @default(cuid())
  organizationId String
  event          String
  planId         String?
  amount         Decimal? @db.Decimal(10, 2)
  asaasPaymentId String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("subscription_history")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           UserRole @default(ORG_MEMBER)
  phone          String?
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization                 Organization              @relation(fields: [organizationId], references: [id])
  assignedTasks                Task[]                    @relation("TaskAssignee")
  createdTasks                 Task[]                    @relation("TaskCreator")
  reviewedRequests             Request[]                 @relation("RequestReviewer")
  comments                     Comment[]
  requestComments              RequestComment[]
  protocols                    Protocol[]
  cancelledProtocols           Protocol[]                @relation("ProtocolCancelledBy")
  attachments                  Attachment[]
  responsibleBoards            Board[]                   @relation("BoardResponsible")
  clientAssignments            ClientAssignment[]
  departments                  UserDepartment[]
  notifications                InAppNotification[]
  approvalsRequested           TaskApproval[]            @relation("ApprovalRequestedBy")
  approvalsDecided             TaskApproval[]            @relation("ApprovalDecidedByUser")
  // ORG_MEMBER only: sees the work of department colleagues (spec visibilidade-por-departamento)
  seesDepartmentWork           Boolean                   @default(true)
  reviewedDocumentRequirements TaskDocumentRequirement[]
  deliveredDeliverables        TaskDeliverable[]
  slaPreference                UserSlaPreference?
  createdObligationTypes       ObligationType[]
  createdDocumentModels        DocumentModel[]
  uploadedDocuments            ReceivedDocument[]        @relation("ReceivedDocumentUploadedBy")
  reviewedDocuments            ReceivedDocument[]        @relation("ReceivedDocumentReviewedBy")

  @@map("users")
}

model UserSlaPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  targetWarningSound  String   @default("SOFT_PING")
  targetWarningVolume Int      @default(50)
  dueCriticalSound    String   @default("BELL")
  dueCriticalVolume   Int      @default(70)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sla_preferences")
}

enum UserRole {
  MASTER
  ORG_ADMIN
  ORG_MANAGER
  ORG_MEMBER
}

model Client {
  id                String  @id @default(cuid())
  name              String
  clientType        String  @default("PJ")
  codigo            String
  cnpj              String?
  cpf               String?
  cei               String?
  caepf             String?
  inscricaoEstadual String?
  whatsapp          String?
  phone             String?
  notes             String?

  cep         String?
  estado      String?
  cidade      String?
  bairro      String?
  logradouro  String?
  numero      String?
  complemento String?

  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization             Organization              @relation(fields: [organizationId], references: [id])
  boards                   Board[]
  requests                 Request[]
  comments                 Comment[]
  requestComments          RequestComment[]
  protocols                Protocol[]
  attachments              Attachment[]
  clientAssignments        ClientAssignment[]
  recurringTaskAssignments RecurringTaskAssignment[]
  clientUserAccesses       ClientUserAccess[]

  // Garantias escritas à mão na migration 20261111120000_client_required_fields (o Prisma não
  // expressa CHECK nem índice parcial — `prisma migrate diff` não detecta drift neles):
  // - CHECK clients_document_by_type_check: PJ exige cnpj, PF exige cpf;
  // - índices únicos parciais (só clientes ativos): clients_codigo_active_key,
  //   clients_cnpj_active_key, clients_cpf_active_key — cliente desativado não trava recadastro.
  @@map("clients")
}

model ClientUser {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String
  passwordHash   String
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accesses         ClientUserAccess[]
  notifications    InAppNotification[]
  approvalsDecided TaskApproval[]      @relation("ApprovalDecidedByClientUser")
  paidProtocols    Protocol[]

  @@unique([email, organizationId])
  @@map("client_users")
}

model ClientUserAccess {
  id           String @id @default(cuid())
  clientUserId String
  clientId     String
  departmentId String

  clientUser ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([clientUserId, clientId, departmentId])
  @@index([clientId])
  @@index([departmentId])
  @@map("client_user_accesses")
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAssignments      ClientAssignment[]
  tasks                  Task[]
  requests               Request[]
  recurringTaskTemplates RecurringTaskTemplate[]
  clientUserAccesses     ClientUserAccess[]
  members                UserDepartment[]

  @@unique([organizationId, name])
  @@map("departments")
}

model ClientAssignment {
  id           String   @id @default(cuid())
  clientId     String
  departmentId String
  userId       String
  createdAt    DateTime @default(now())

  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, departmentId])
  @@map("client_assignments")
}

model Board {
  inAppNotifications InAppNotification[]
  id                 String              @id @default(cuid())
  title              String
  description        String?
  organizationId     String
  clientId           String
  responsibleUserId  String?
  isActive           Boolean             @default(true)
  dueDate            DateTime?
  type               BoardType           @default(OS)
  osTemplateId       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  client          Client       @relation(fields: [clientId], references: [id])
  responsibleUser User?        @relation("BoardResponsible", fields: [responsibleUserId], references: [id])
  osTemplate      OSTemplate?  @relation(fields: [osTemplateId], references: [id])
  columns         Column[]

  @@map("boards")
}

model Request {
  inAppNotifications InAppNotification[]
  id                 String              @id @default(cuid())
  organizationId     String
  clientId           String
  title              String
  description        String?
  status             RequestStatus       @default(PENDING)
  taskId             String?             @unique
  departmentId       String
  rejectionReason    String?
  reviewedById       String?
  reviewedAt         DateTime?
  osTemplateId       String?
  cancelledByType    CommentAuthorType?
  cancelledById      String?
  cancellationReason String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  client       Client              @relation(fields: [clientId], references: [id])
  task         Task?               @relation(fields: [taskId], references: [id])
  department   Department          @relation(fields: [departmentId], references: [id])
  reviewedBy   User?               @relation("RequestReviewer", fields: [reviewedById], references: [id])
  osTemplate   OSTemplate?         @relation(fields: [osTemplateId], references: [id])
  attachments  RequestAttachment[]
  comments     RequestComment[]

  @@index([organizationId, status])
  @@index([departmentId])
  @@map("requests")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  NEEDS_INFO
}

model RequestAttachment {
  id         String   @id @default(cuid())
  requestId  String
  filename   String
  mimeType   String
  size       Int
  storageKey String
  uploadedBy String
  createdAt  DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("request_attachments")
}

model RequestComment {
  id            String            @id @default(cuid())
  content       String
  requestId     String
  authorType    CommentAuthorType
  userId        String?
  clientId      String?
  deletedAt     DateTime?
  deletedBy     String?
  deletedByType DeletedByType?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])
  client  Client? @relation(fields: [clientId], references: [id])

  // listRequestComments ordena por requestId + createdAt.
  @@index([requestId, createdAt])
  @@map("request_comments")
}

model Column {
  id           String             @id @default(cuid())
  title        String
  position     Int
  color        String?
  statusEffect ColumnStatusEffect @default(NONE)
  notifyClient Boolean            @default(false)
  boardId      String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  board     Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]
  documents ColumnDocument[]

  @@map("columns")
}

model ColumnDocument {
  id       String @id @default(cuid())
  columnId String
  name     String
  position Int

  column Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@map("column_documents")
}

model Task {
  inAppNotifications  InAppNotification[]
  id                  String              @id @default(cuid())
  title               String
  description         String?
  position            Int
  priority            Priority            @default(MEDIUM)
  status              TaskStatus          @default(OPEN)
  dueDate             DateTime?
  columnId            String
  assigneeId          String?
  creatorId           String?
  sourceRequestId     String?
  departmentId        String
  tags                String[]
  competence          DateTime?
  targetDate          DateTime?
  completedAt         DateTime?
  recurringTemplateId String?
  visibleToClient     Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  column               Column                    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee             User?                     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator              User?                     @relation("TaskCreator", fields: [creatorId], references: [id])
  department           Department                @relation(fields: [departmentId], references: [id])
  comments             Comment[]
  history              TaskHistory[]
  attachments          Attachment[]
  sourceForRequest     Request?
  recurringTemplate    RecurringTaskTemplate?    @relation(fields: [recurringTemplateId], references: [id])
  documentRequirements TaskDocumentRequirement[]
  deliverables         TaskDeliverable[]
  approvals            TaskApproval[]
  protocols            Protocol[]
  receivedDocuments    ReceivedDocument[]

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([title])
  @@index([competence])
  @@index([targetDate])
  @@index([departmentId])
  @@index([completedAt])
  @@index([assigneeId])
  @@map("tasks")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  STARTED
  DONE
  DISREGARDED
  BLOCKED
}

enum ColumnStatusEffect {
  NONE
  OPEN
  STARTED
  BLOCKED
  DISREGARDED
  DONE
}

enum BoardType {
  OS
  RECURRING_SYSTEM
}

model OSTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  columns      OSTemplateColumn[]
  requests     Request[]
  boards       Board[]

  @@map("os_templates")
}

model OSTemplateColumn {
  id           String             @id @default(cuid())
  templateId   String
  title        String
  position     Int
  statusEffect ColumnStatusEffect @default(NONE)
  notifyClient Boolean            @default(false)

  template  OSTemplate                 @relation(fields: [templateId], references: [id], onDelete: Cascade)
  documents OSTemplateColumnDocument[]

  @@map("os_template_columns")
}

model OSTemplateColumnDocument {
  id       String @id @default(cuid())
  columnId String
  name     String
  position Int

  column OSTemplateColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@map("os_template_column_documents")
}

model RecurringTaskTemplate {
  id               String                @id @default(cuid())
  organizationId   String
  departmentId     String
  // Só preenchido pra templates que geram uma obrigação lida pelo robô de documentos — permite
  // casar (cliente, obrigação, competência) com confiança, em vez de comparar title (texto livre).
  obligationTypeId String?
  title            String
  description      String?
  periodicity      RecurrencePeriodicity
  priority         Priority              @default(MEDIUM)

  dueDayOfPeriod     Int
  dueBusinessDayRoll BusinessDayRoll @default(NONE)

  // Mês-âncora de vencimento — só relevante pra QUARTERLY (valor 1-3, define qual dos 3 grupos
  // de meses: 1="Jan,Abr,Jul,Out", 2="Fev,Mai,Ago,Nov", 3="Mar,Jun,Set,Dez", via mês % 3) e
  // ANNUAL (valor 1-12, mês literal do vencimento). Ignorado por MONTHLY/WEEKLY.
  dueMonthAnchor Int @default(1)

  competenceMonthOffset Int @default(1)

  targetOffsetDays      Int             @default(0)
  targetBusinessDayRoll BusinessDayRoll @default(NONE)

  generationMonthOffset Int @default(1)
  generationDayOfPeriod Int

  autoCompleteOnAllActivitiesDone Boolean @default(false)

  notifyViaWhatsapp Boolean @default(true)
  notifyViaEmail    Boolean @default(false)

  visibleToClient Boolean @default(true)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization       Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department         Department                      @relation(fields: [departmentId], references: [id])
  obligationType     ObligationType?                 @relation(fields: [obligationTypeId], references: [id])
  documentRequests   RecurringTaskTemplateDocument[] @relation("TemplateDocumentRequests")
  documentDeliveries RecurringTaskTemplateDocument[] @relation("TemplateDocumentDeliveries")
  assignments        RecurringTaskAssignment[]
  tasks              Task[]
  generationLogs     RecurringGenerationLog[]

  @@map("recurring_task_templates")
}

enum RecurrencePeriodicity {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum BusinessDayRoll {
  NONE
  FORWARD
  BACKWARD
}

model RecurringTaskTemplateDocument {
  id                 String  @id @default(cuid())
  requestTemplateId  String?
  deliveryTemplateId String?
  name               String
  position           Int
  // Only meaningful on delivery rows: the generated deliverable is a payment guide
  requiresPayment    Boolean @default(false)

  requestTemplate  RecurringTaskTemplate? @relation("TemplateDocumentRequests", fields: [requestTemplateId], references: [id], onDelete: Cascade)
  deliveryTemplate RecurringTaskTemplate? @relation("TemplateDocumentDeliveries", fields: [deliveryTemplateId], references: [id], onDelete: Cascade)

  @@map("recurring_task_template_documents")
}

model RecurringTaskAssignment {
  id         String   @id @default(cuid())
  templateId String
  clientId   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  template RecurringTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  client   Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([templateId, clientId])
  @@map("recurring_task_assignments")
}

model RecurringGenerationLog {
  id           String           @id @default(cuid())
  templateId   String
  clientId     String
  competence   DateTime
  status       GenerationStatus
  taskId       String?
  errorMessage String?
  createdAt    DateTime         @default(now())

  template RecurringTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, clientId, competence])
  @@map("recurring_generation_logs")
}

enum GenerationStatus {
  SUCCESS
  FAILED
}

model TaskDocumentRequirement {
  id              String                    @id @default(cuid())
  taskId          String
  name            String
  status          DocumentRequirementStatus @default(PENDING)
  attachmentId    String?                   @unique
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  position        Int
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attachment Attachment? @relation(fields: [attachmentId], references: [id])
  reviewedBy User?       @relation(fields: [reviewedById], references: [id])

  @@map("task_document_requirements")
}

enum DocumentRequirementStatus {
  PENDING
  UPLOADED
  APPROVED
  REJECTED
  NOT_APPLICABLE
}

model TaskDeliverable {
  id              String    @id @default(cuid())
  taskId          String
  name            String
  attachmentId    String?   @unique
  deliveredById   String?
  deliveredAt     DateTime?
  position        Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Payment guide (DAS, FGTS...): amount and due date informed by the office on delivery
  requiresPayment Boolean   @default(false)
  amount          Decimal?  @db.Decimal(12, 2)
  paymentDueDate  DateTime?

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attachment  Attachment? @relation(fields: [attachmentId], references: [id])
  deliveredBy User?       @relation(fields: [deliveredById], references: [id])
  protocol    Protocol?

  @@map("task_deliverables")
}

model Protocol {
  id             String         @id @default(cuid())
  organizationId String
  number         String
  clientId       String
  taskId         String
  attachmentId   String?        @unique
  title          String
  content        String?
  dueDate        DateTime?
  status         ProtocolStatus @default(SENT)
  createdById    String
  createdAt      DateTime       @default(now())

  // Client portal "documentos recebidos": competence, payment and lifecycle. dueDate above is the
  // guide's due date (vencimento).
  competence               DateTime?
  requiresPayment          Boolean   @default(false)
  amount                   Decimal?  @db.Decimal(12, 2)
  paidAt                   DateTime?
  paidAmount               Decimal?  @db.Decimal(12, 2)
  paidByClientUserId       String?
  paymentProofAttachmentId String?   @unique
  deliverableId            String?   @unique
  cancelledAt              DateTime?
  cancelledById            String?
  cancellationReason       String?
  fileUpdatedAt            DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id])
  client       Client           @relation(fields: [clientId], references: [id])
  task         Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attachment   Attachment?      @relation(fields: [attachmentId], references: [id])
  createdBy    User             @relation(fields: [createdById], references: [id])
  events       ProtocolEvent[]
  paidBy       ClientUser?      @relation(fields: [paidByClientUserId], references: [id])
  paymentProof Attachment?      @relation("ProtocolPaymentProof", fields: [paymentProofAttachmentId], references: [id])
  deliverable  TaskDeliverable? @relation(fields: [deliverableId], references: [id])
  cancelledBy  User?            @relation("ProtocolCancelledBy", fields: [cancelledById], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([clientId])
  @@index([organizationId, requiresPayment, paidAt])
  @@map("protocols")
}

enum ProtocolStatus {
  SENT
  VIEWED
  DOWNLOADED
  EXPIRED
}

model ProtocolEvent {
  id                   String            @id @default(cuid())
  protocolId           String
  type                 ProtocolEventType
  actorType            String
  actorId              String?
  actorName            String?
  actorEmail           String?
  ip                   String?
  userAgent            String?
  createdAt            DateTime          @default(now())
  // Free text shown in the history ("R$ 10,00 → R$ 12,00", cancellation reason)
  detail               String?
  // File replaced by a REPLACED event — kept, never deleted
  previousAttachmentId String?

  protocol Protocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  @@index([protocolId, createdAt])
  @@map("protocol_events")
}

enum ProtocolEventType {
  SENT
  VIEWED
  DOWNLOADED
  EXPIRED
  PAID
  UNPAID
  AMOUNT_CHANGED
  REPLACED
  CANCELLED
}

model ProtocolCounter {
  organizationId String
  year           Int
  lastNumber     Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, year])
  @@map("protocol_counters")
}

model Comment {
  id            String            @id @default(cuid())
  content       String
  taskId        String
  authorType    CommentAuthorType
  userId        String?
  clientId      String?
  deletedAt     DateTime?
  deletedBy     String?
  deletedByType DeletedByType?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  // listComments ordena por taskId + createdAt — débito pré-existente ao Plano de
  // Solicitações->OS, corrigido junto com RequestComment por serem o mesmo padrão.
  @@index([taskId, createdAt])
  @@map("comments")
}

enum CommentAuthorType {
  USER
  CLIENT
}

enum DeletedByType {
  USER
  CLIENT
}

model TaskHistory {
  id        String   @id @default(cuid())
  taskId    String
  action    String
  fromValue String?
  toValue   String?
  actorType String
  actorId   String
  actorName String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Postgres não indexa FK automaticamente (diferente de MySQL) — sem isso, toda consulta de
  // métricas (`taskId: { in: [...] }`) varre a tabela inteira sequencialmente.
  @@index([taskId, action, createdAt])
  @@map("task_history")
}

model Attachment {
  id               String    @id @default(cuid())
  taskId           String
  filename         String
  mimeType         String
  size             Int
  storageKey       String
  uploadedBy       String?
  uploadedByClient String?
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?
  deletedBy        String?
  deletedByClient  String?
  deletedByName    String?

  task                Task                     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader            User?                    @relation(fields: [uploadedBy], references: [id])
  uploaderClient      Client?                  @relation(fields: [uploadedByClient], references: [id])
  documentRequirement TaskDocumentRequirement?
  deliverable         TaskDeliverable?
  protocol            Protocol?
  receivedDocument    ReceivedDocument?
  paymentProofOf      Protocol?                @relation("ProtocolPaymentProof")
  approvalFileOf      TaskApproval?            @relation("ApprovalFile")
  approvalProofOf     TaskApproval?            @relation("ApprovalProof")

  @@map("attachments")
}

